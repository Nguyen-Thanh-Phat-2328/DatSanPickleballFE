@using Frontend.DataAdmin
@model MyOrderView
@{
    Layout = "_Layout";
    ViewData["Title"] = "Chi tiết hóa đơn";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <link rel="stylesheet" href="/css/OrderDetail.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="container">
        <main class="order-detail-main">
            <!-- Header -->
            <div class="order-header">
                <button class="back-btn" onclick="backToOrder()">
                    <i class="fas fa-arrow-left"></i>
                    Quay lại
                </button>
                <h1>Chi tiết đơn hàng</h1>
            </div>

            <!-- Order Status Timeline -->
            <div class="status-card">
                <div class="status-timeline" id="statusTimeline">
                    <div class="status-step active">
                        <div class="status-icon">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                        <div class="status-text">
                            <span class="status-title">Đặt hàng</span>
                            <span class="status-time" id="orderTime"></span>
                        </div>
                    </div>
                    <div class="status-step">
                        <div class="status-icon">
                            <i class="fas fa-credit-card"></i>
                        </div>
                        <div class="status-text">
                            <span class="status-title">Xác nhận</span>
                        </div>
                    </div>
                    <div class="status-step">
                        <div class="status-icon">
                            <i class="fas fa-truck"></i>
                        </div>
                        <div class="status-text">
                            <span class="status-title">Vận chuyển</span>
                        </div>
                    </div>
                    <div class="status-step">
                        <div class="status-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="status-text">
                            <span class="status-title">Hoàn thành</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Information -->
            <div class="info-card">
                <h2><i class="fas fa-info-circle"></i> Thông tin đơn hàng</h2>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Mã đơn hàng:</span>
                        <span class="info-value" id="orderCode"></span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Ngày đặt:</span>
                        <span class="info-value" id="orderDate"></span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Tổng tiền:</span>
                        <span class="info-value total-amount" id="totalAmount"></span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Trạng thái:</span>
                        <span class="info-value status-badge" id="orderStatus"></span>
                    </div>
                </div>
            </div>

            <!-- Delivery Address -->
            <div class="address-card">
                <h2><i class="fas fa-map-marker-alt"></i> Địa chỉ giao hàng</h2>
                <div class="address-content">
                    <div class="address-text" id="deliveryAddress"></div>
                </div>
            </div>

            <!-- Order Items -->
            <div class="items-card">
                <h2><i class="fas fa-shopping-bag"></i> Sản phẩm đã đặt</h2>
                <div class="items-list" id="orderItems">
                    <!-- Items will be loaded here -->
                </div>
            </div>

            <!-- Order Summary -->
            <div class="summary-card">
                <h2><i class="fas fa-receipt"></i> Tóm tắt đơn hàng</h2>
                <div class="summary-content">
                    <div class="summary-row">
                        <span>Tạm tính:</span>
                        <span id="subtotal"></span>
                    </div>
                    <div class="summary-row">
                        <span>Phí vận chuyển:</span>
                        <span id="shippingFee">30.000₫</span>
                    </div>
                    <div class="summary-row total">
                        <span>Tổng cộng:</span>
                        <span id="finalTotal"></span>
                    </div>
                </div>
            </div>

            <!-- Added action buttons for reorder and cancel -->
            <div class="action-buttons">
                <button class="btn-reorder" onclick="reorderItems()">
                    <i class="fas fa-redo"></i>
                    Đặt lại
                </button>
                <button class="btn-cancel" id="cancelBtn" onclick="cancelOrder()">
                    <i class="fas fa-times"></i>
                    Hủy đơn
                </button>
            </div>
        </main>
    </div>

    <script src="/js/OrderDetail.js"></script>
</body>
</html>