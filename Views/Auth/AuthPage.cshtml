@{
    Layout = "_Layout";
    ViewData["Title"] = "Authentication";
}
<!-- Auth Page -->
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập Pickleball - Sân Tuấn Phát</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/Auth.css">
</head>
<body>
    <img src="/css/img/ball.png" alt="Pickleball" class="animated-ball">
        <div class="container">
            <div class="auth-container">
                <div class="auth-card">
                    <div class="auth-header">
                        <div class="logo-auth">
                            <i class="fas fa-table-tennis"></i>
                            <h2>Sân Pickleball Tuấn Phát</h2>
                        </div>
                        <div class="auth-tabs">
                            <button class="auth-tab active" onclick="switchAuthTab('login')">Đăng nhập</button>
                            <button class="auth-tab" onclick="switchAuthTab('register')">Đăng ký</button>
                        </div>
                    </div>

                    <!-- Login Form -->
                    <div id="login-form" class="auth-form active">
                        <form onsubmit="handleLogin(event)">
                            <div class="form-group">
                                <label for="login-email">
                                    <i class="fas fa-envelope"></i>
                                    Email
                                </label>
                                <input type="email" id="login-email" name="email" required
                                       placeholder="Nhập email của bạn">
                            </div>

                            <div class="form-group">
                                <label for="login-password">
                                    <i class="fas fa-lock"></i>
                                    Mật khẩu
                                </label>
                                <div class="password-input">
                                    <input type="password" id="login-password" name="password" required
                                           placeholder="Nhập mật khẩu">
                                    <button type="button" class="toggle-password" onclick="togglePassword('login-password')">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="form-options">
                                <label class="checkbox-container">
                                    <input type="checkbox" name="remember">
                                    <span class="checkmark"></span>
                                    Ghi nhớ đăng nhập
                                </label>
                                <a class="forgot-password" onclick="switchAuthTab('pickemail')">Quên mật khẩu?</a>
                            </div>

                            <button type="submit" class="auth-btn">
                                <i class="fas fa-sign-in-alt"></i>
                                Đăng nhập
                            </button>
                        </form>

                        <div class="auth-divider">
                            <span>Hoặc đăng nhập với</span>
                        </div>

                        <div class="social-login">
                            <button class="social-btn google" onclick="loginWithGoogle()">
                                <i class="fab fa-google"></i>
                                Google
                            </button>
                            <button class="social-btn facebook" onclick="loginWithFacebook()">
                                <i class="fab fa-facebook-f"></i>
                                Facebook
                            </button>
                        </div>
                    </div>

                    <!-- Register Form -->
                    <div id="register-form" class="auth-form">
                        <form onsubmit="handleRegister(event)">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="register-firstname">
                                        <i class="fas fa-user"></i>
                                        Họ
                                    </label>
                                    <input type="text" id="register-firstname" name="firstname" required
                                           placeholder="Nhập họ">
                                </div>
                                <div class="form-group">
                                    <label for="register-lastname">
                                        <i class="fas fa-user"></i>
                                        Tên
                                    </label>
                                    <input type="text" id="register-lastname" name="lastname" required
                                           placeholder="Nhập tên">
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="register-email">
                                    <i class="fas fa-envelope"></i>
                                    Email
                                </label>
                                <input type="email" id="register-email" name="email" required
                                       placeholder="Nhập email của bạn">
                            </div>

                            <div class="form-group">
                                <label for="register-phone">
                                    <i class="fas fa-phone"></i>
                                    Số điện thoại
                                </label>
                                <input type="tel" id="register-phone" name="phone" required
                                       placeholder="Nhập số điện thoại">
                            </div>

                            <div class="form-group">
                                <label for="register-password">
                                    <i class="fas fa-lock"></i>
                                    Mật khẩu
                                </label>
                                <div class="password-input">
                                    <input type="password" id="register-password" name="password" required
                                           placeholder="Nhập mật khẩu (tối thiểu 6 ký tự)">
                                    <button type="button" class="toggle-password" onclick="togglePassword('register-password')">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="register-confirm-password">
                                    <i class="fas fa-lock"></i>
                                    Xác nhận mật khẩu
                                </label>
                                <div class="password-input">
                                    <input type="password" id="register-confirm-password" name="confirmPassword" required
                                           placeholder="Nhập lại mật khẩu">
                                    <button type="button" class="toggle-password" onclick="togglePassword('register-confirm-password')">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="form-options">
                                <label class="checkbox-container">
                                    <input type="checkbox" name="terms" required>
                                    <span class="checkmark"></span>
                                    Tôi đồng ý với <a href="#" class="terms-link">Điều khoản sử dụng</a>
                                </label>
                            </div>

                            <button type="submit" class="auth-btn">
                                <i class="fas fa-user-plus"></i>
                                Đăng ký
                            </button>
                        </form>
                    </div>

                    <!-- Pick Email Form -->
                    <div id="pickemail-form" class="auth-form">
                        <form onsubmit="handlePickEmail(event)">
                            <!-- Email -->
                            <div class="form-group">
                                <label for="picl-email">
                                    <i class="fas fa-envelope"></i>
                                    Email
                                </label>
                                <input type="email" id="pick-email" name="email" required
                                       placeholder="Nhập email của bạn">
                            </div>                        

                            <!-- Nút xác nhận -->
                            <button type="submit" class="auth-btn">
                                <i class="fas fa-key"></i>
                                Email link
                            </button>
                        </form>
                    </div>

                    <!-- Forgot Password Form -->
                    <div id="forgotpassword-form" class="auth-form">
                        <form onsubmit="handleForgotPassword(event)">                           
                            <!-- Mật khẩu mới -->
                            <div class="form-group">
                                <label for="forgot-new-password">
                                    <i class="fas fa-lock"></i>
                                    Mật khẩu mới
                                </label>
                                <div class="password-input">
                                    <input type="password" id="forgot-new-password" name="newPassword" required
                                           placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)">
                                    <button type="button" class="toggle-password" onclick="togglePassword('forgot-new-password')">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Xác nhận mật khẩu mới -->
                            <div class="form-group">
                                <label for="forgot-confirm-password">
                                    <i class="fas fa-lock"></i>
                                    Xác nhận mật khẩu mới
                                </label>
                                <div class="password-input">
                                    <input type="password" id="forgot-confirm-password" name="confirmNewPassword" required
                                           placeholder="Nhập lại mật khẩu mới">
                                    <button type="button" class="toggle-password" onclick="togglePassword('forgot-confirm-password')">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Mã OTP -->
                            <div class="form-group">
                                <label for="forgot-otp">
                                    <i class="fas fa-key"></i>
                                    Mã OTP
                                </label>
                                <input type="text" id="forgot-otp" name="otp" required
                                       placeholder="Nhập mã OTP gồm 6 số" maxlength="6" pattern="\d{6}">
                            </div>

                            <!-- Nút xác nhận -->
                            <button type="submit" class="auth-btn">
                                <i class="fas fa-key"></i>
                                Đặt lại mật khẩu
                            </button>
                        </form>
                    </div>


                    <div class="auth-footer">
                        <button class="back-to-home" >
                            <i class="fas fa-arrow-left"></i>
                            <a style="text-decoration:none;" href="@Url.Action("Index", "TrangChu")">Về trang chủ</a>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    
    <script>
        const ball = document.querySelector(".animated-ball");
        const ballSize = 100;

        let x = Math.random() * (window.innerWidth - ballSize);
        let y = Math.random() * (window.innerHeight - ballSize);

        function getRandomDirection() {
            const angle = Math.random() * 2 * Math.PI;
            const speed = Math.random() * 2 + 2; // 2–4 px mỗi frame
            return {
                dx: Math.cos(angle) * speed,
                dy: Math.sin(angle) * speed
            };
        }

        let { dx, dy } = getRandomDirection();

        function addRandomVariation(value) {
            // thêm chút biến thiên ngẫu nhiên để hướng đa dạng
            const variation = (Math.random() - 0.5) * 1; // từ -0.5 đến +0.5
            return value + variation;
        }

        function moveBall() {
            const screenWidth = window.innerWidth;
            const screenHeight = window.innerHeight;

            x += dx;
            y += dy;

            // Va chạm trái/phải
            if (x <= 0 || x + ballSize >= screenWidth) {
                dx = -dx;
                dx = addRandomVariation(dx);
                dy = addRandomVariation(dy);

                if (x <= 0) x = 0;
                if (x + ballSize >= screenWidth) x = screenWidth - ballSize;
            }

            // Va chạm trên/dưới
            if (y <= 0 || y + ballSize >= screenHeight) {
                dy = -dy;
                dx = addRandomVariation(dx);
                dy = addRandomVariation(dy);

                if (y <= 0) y = 0;
                if (y + ballSize >= screenHeight) y = screenHeight - ballSize;
            }

            // Giới hạn tốc độ để không bị quá nhanh
            const speedLimit = 6;
            dx = Math.max(Math.min(dx, speedLimit), -speedLimit);
            dy = Math.max(Math.min(dy, speedLimit), -speedLimit);

            // Render mượt
            ball.style.transform = `translate3d(${x}px, ${y}px, 0)`;

            requestAnimationFrame(moveBall);
        }

        moveBall();

        window.addEventListener("resize", () => {
            if (x + ballSize > window.innerWidth) x = window.innerWidth - ballSize;
            if (y + ballSize > window.innerHeight) y = window.innerHeight - ballSize;
        });
    </script>

    <script>
        const homeUrl = '@Url.Action("Index", "TrangChu")';           
    </script>
</body>
</html>
