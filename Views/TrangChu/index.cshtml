@using Frontend.DataAdmin
@model ThongTinChungView
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đặt Sân Pickleball - Sân Tuấn Phát</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="logo">
                <i class="fas fa-table-tennis"></i>
                <h1>Sân Pickleball Tuấn Phát</h1>
            </div>
            <nav class="nav">
                <a href="#home" onclick="showPage('home')">Trang chủ</a>
                <a href="#courts" onclick="showPage('courts')">Shop</a>
                <a href="#contact" onclick="showPage('contact')">Liên hệ</a>
                <a href="#auth" onclick="showPage('auth')">Đăng nhập</a>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Auth Page -->
        <div id="auth-page" class="page">
            <div class="container">
                <div class="auth-container">
                    <div class="auth-card">
                        <div class="auth-header">
                            <div class="logo-auth">
                                <i class="fas fa-table-tennis"></i>
                                <h2>Sân Pickleball Tuấn Phát</h2>
                            </div>
                            <div class="auth-tabs">
                                <button class="auth-tab active" onclick="switchAuthTab('login')">Đăng nhập</button>
                                <button class="auth-tab" onclick="switchAuthTab('register')">Đăng ký</button>
                            </div>
                        </div>

                        <!-- Login Form -->
                        <div id="login-form" class="auth-form active">
                            <form onsubmit="handleLogin(event)">
                                <div class="form-group">
                                    <label for="login-email">
                                        <i class="fas fa-envelope"></i>
                                        Email
                                    </label>
                                    <input type="email" id="login-email" name="email" required
                                           placeholder="Nhập email của bạn">
                                </div>

                                <div class="form-group">
                                    <label for="login-password">
                                        <i class="fas fa-lock"></i>
                                        Mật khẩu
                                    </label>
                                    <div class="password-input">
                                        <input type="password" id="login-password" name="password" required
                                               placeholder="Nhập mật khẩu">
                                        <button type="button" class="toggle-password" onclick="togglePassword('login-password')">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="form-options">
                                    <label class="checkbox-container">
                                        <input type="checkbox" name="remember">
                                        <span class="checkmark"></span>
                                        Ghi nhớ đăng nhập
                                    </label>
                                    <a href="#" class="forgot-password">Quên mật khẩu?</a>
                                </div>

                                <button type="submit" class="auth-btn">
                                    <i class="fas fa-sign-in-alt"></i>
                                    Đăng nhập
                                </button>
                            </form>

                            <div class="auth-divider">
                                <span>Hoặc đăng nhập với</span>
                            </div>

                            <div class="social-login">
                                <button class="social-btn google" onclick="loginWithGoogle()">
                                    <i class="fab fa-google"></i>
                                    Google
                                </button>
                                <button class="social-btn facebook" onclick="loginWithFacebook()">
                                    <i class="fab fa-facebook-f"></i>
                                    Facebook
                                </button>
                            </div>
                        </div>

                        <!-- Register Form -->
                        <div id="register-form" class="auth-form">
                            <form onsubmit="handleRegister(event)">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="register-firstname">
                                            <i class="fas fa-user"></i>
                                            Họ
                                        </label>
                                        <input type="text" id="register-firstname" name="firstname" required
                                               placeholder="Nhập họ">
                                    </div>
                                    <div class="form-group">
                                        <label for="register-lastname">
                                            <i class="fas fa-user"></i>
                                            Tên
                                        </label>
                                        <input type="text" id="register-lastname" name="lastname" required
                                               placeholder="Nhập tên">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="register-email">
                                        <i class="fas fa-envelope"></i>
                                        Email
                                    </label>
                                    <input type="email" id="register-email" name="email" required
                                           placeholder="Nhập email của bạn">
                                </div>

                                <div class="form-group">
                                    <label for="register-phone">
                                        <i class="fas fa-phone"></i>
                                        Số điện thoại
                                    </label>
                                    <input type="tel" id="register-phone" name="phone" required
                                           placeholder="Nhập số điện thoại">
                                </div>

                                <div class="form-group">
                                    <label for="register-password">
                                        <i class="fas fa-lock"></i>
                                        Mật khẩu
                                    </label>
                                    <div class="password-input">
                                        <input type="password" id="register-password" name="password" required
                                               placeholder="Nhập mật khẩu (tối thiểu 6 ký tự)">
                                        <button type="button" class="toggle-password" onclick="togglePassword('register-password')">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="register-confirm-password">
                                        <i class="fas fa-lock"></i>
                                        Xác nhận mật khẩu
                                    </label>
                                    <div class="password-input">
                                        <input type="password" id="register-confirm-password" name="confirmPassword" required
                                               placeholder="Nhập lại mật khẩu">
                                        <button type="button" class="toggle-password" onclick="togglePassword('register-confirm-password')">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="form-options">
                                    <label class="checkbox-container">
                                        <input type="checkbox" name="terms" required>
                                        <span class="checkmark"></span>
                                        Tôi đồng ý với <a href="#" class="terms-link">Điều khoản sử dụng</a>
                                    </label>
                                </div>

                                <button type="submit" class="auth-btn">
                                    <i class="fas fa-user-plus"></i>
                                    Đăng ký
                                </button>
                            </form>
                        </div>

                        <div class="auth-footer">
                            <button class="back-to-home" onclick="showPage('home')">
                                <i class="fas fa-arrow-left"></i>
                                Về trang chủ
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Home Page -->
        <div id="home-page" class="page active">
            <div class="container">
                <div class="content-grid">
                    <!-- Court Info -->
                    <div class="court-info">
                        <div class="info-card">
                            <div class="info-header">
                                <i class="fas fa-map-marker-alt"></i>
                                <h2>Thông tin sân</h2>
                            </div>
                            <div class="info-content">
                                <div class="info-item">
                                    <i class="fas fa-building"></i>
                                    <div>
                                        <h3>Sân Tuấn Phát</h3>
                                        <p>Hệ thống sân pickleball chuyên nghiệp</p>
                                    </div>
                                </div>
                                <div class="info-item">
                                    <i class="fas fa-location-dot"></i>
                                    <div>
                                        <h3>Địa chỉ</h3>
                                        <p>123 Đường ABC, Quận Hải Châu, Đà Nẵng</p>
                                    </div>
                                </div>
                                <div class="info-item">
                                    <i class="fas fa-phone"></i>
                                    <div>
                                        <h3>Liên hệ</h3>
                                        <p>0905 123 456</p>
                                    </div>
                                </div>
                                <div class="info-item">
                                    <i class="fas fa-clock"></i>
                                    <div>
                                        <h3>Giờ hoạt động</h3>
                                        <p>6:00 - 23:00 (Hàng ngày)</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Courts List -->
                    <div class="courts-list">
                        <h2>Chọn sân để đặt</h2>
                        <div class="courts-grid">

                            @foreach(var c in Model.ListSan)
                            {
                                <div class="court-card" onclick="selectCourt(1)">
                                    <div class="court-image">
                                        <img src="/css/img/san1.jpg?height=200&width=300" alt="Sân 1">
                                        <div class="court-overlay">
                                            <h3>@c.TenSan</h3>
                                            <p>@c.KieuSan</p>
                                        </div>
                                    </div>
                                    <div class="court-details">
                                        <div class="court-status available">
                                            <i class="fas fa-check-circle"></i>
                                            <span>@c.TrangThai</span>
                                        </div>
                                        <button class="book-btn">Đặt sân</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Booking Page -->
        <div id="booking-page" class="page">
            <div class="container">
                <div class="booking-header">
                    <button class="back-btn" onclick="goBack()">
                        <i class="fas fa-arrow-left"></i>
                        Quay lại
                    </button>
                    <h2 id="selected-court-title">Đặt sân</h2>
                </div>

                <div class="booking-content">
                    <div class="court-preview">
                        <img id="court-preview-img" src="/placeholder.svg?height=300&width=400" alt="Court Preview">
                        <div class="court-info-booking">
                            <h3 id="court-name">Sân 1</h3>
                            <p>Giá: <span class="price">150.000đ/giờ</span></p>
                        </div>
                    </div>

                    <div class="booking-calendar">
                        <div class="calendar-header">
                            <h3>Chọn ngày và giờ</h3>
                            <div class="legend">
                                <div class="legend-item">
                                    <div class="legend-color available"></div>
                                    <span>Sẵn trống</span>
                                </div>
                                <div class="legend-item">
                                    <div class="legend-color booked"></div>
                                    <span>Đã được đặt</span>
                                </div>
                                <div class="legend-item">
                                    <div class="legend-color selected"></div>
                                    <span>Đã chọn</span>
                                </div>
                            </div>
                        </div>

                        <div class="date-selector">
                            <button class="date-nav" onclick="changeWeek(-1)">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <div class="dates-container" id="dates-container">
                                <!-- Dates will be generated by JavaScript -->
                            </div>
                            <button class="date-nav" onclick="changeWeek(1)">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>

                        <div class="time-slots" id="time-slots">
                            <!-- Time slots will be generated by JavaScript -->
                        </div>

                        <div class="booking-summary" id="booking-summary" style="display: none;">
                            <h4>Thông tin đặt sân</h4>
                            <div class="summary-details">
                                <p><strong>Sân:</strong> <span id="summary-court"></span></p>
                                <p><strong>Ngày:</strong> <span id="summary-date"></span></p>
                                <p><strong>Giờ:</strong> <span id="summary-time"></span></p>
                                <p><strong>Tổng tiền:</strong> <span id="summary-total" class="price"></span></p>
                            </div>
                            <button class="confirm-btn" onclick="confirmBooking()">
                                <i class="fas fa-check"></i>
                                Xác nhận đặt sân
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Success Modal -->
    <div id="success-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <i class="fas fa-check-circle success-icon"></i>
                <h3>Đặt sân thành công!</h3>
            </div>
            <div class="modal-body">
                <p>Cảm ơn bạn đã đặt sân. Chúng tôi sẽ liên hệ với bạn sớm nhất.</p>
                <div class="booking-details">
                    <p><strong>Mã đặt sân:</strong> <span id="booking-code"></span></p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="modal-btn" onclick="closeModal()">Đóng</button>
            </div>
        </div>
    </div>

    <partial name="ContactPage" />

    <partial name="ProfileModal" />
    <partial name="HistoryBookingModal" />

    <script src="/js/script.js"></script>
</body>
</html>