<link rel="stylesheet" href="~/css/ProfileModal.css" />
@{

    <!-- Modal Chỉnh sửa thông tin -->
    <div id="profileModal" class="modal">
        <div class="modal-content">
            <h2>Thông tin người dùng</h2>
            <div class="form-group">
                <label for="profileId">Mã người dùng:</label>
                <input type="text" id="profileId" disabled />
            </div>
            <div class="form-group">
                <label for="profileFullName">Họ tên:</label>
                <input type="text" id="profileFullName" />
            </div>
            <div class="form-group">
                <label for="profileEmail">Email:</label>
                <input type="email" id="profileEmail" />
            </div>
            <div class="form-group">
                <label for="profilePhone">Số điện thoại:</label>
                <input type="text" id="profilePhone" />
            </div>
            <div class="modal-buttons">
                <button class="btn btn-save" onclick="saveProfile()">Lưu</button>
                <button class="btn btn-close" onclick="closeProfileModal()">Đóng</button>
            </div>
        </div>
    </div>
}
