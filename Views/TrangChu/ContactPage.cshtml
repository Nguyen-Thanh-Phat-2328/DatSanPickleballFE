<link rel="stylesheet" href="~/css/ContactPage.css" />
@{
    <div id="contact-page" class="page">
        <div class="container py-5">
            <h2 class="mb-4 text-center">Liên hệ với chúng tôi</h2>

            <div class="contact-wrapper">
                <!-- Thông tin liên hệ -->
                <div class="contact-info card">
                    <h4><i class="fas fa-info-circle text-primary"></i> Thông tin liên hệ</h4>
                    <p><i class="fas fa-map-marker-alt text-danger"></i> 32 Ngô Chi Lan, Quận Hải Châu, Đà Nẵng</p>
                    <p><i class="fas fa-phone text-primary"></i> 0905 123 456</p>
                    <p><i class="fas fa-envelope text-warning"></i> lienhe@tuanphatpickleball.com</p>
                    <p><i class="fas fa-clock text-success"></i> 6:00 - 23:00 (Hàng ngày)</p>
                </div>

                <!-- Bản đồ -->
                <div class="contact-map card">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d239.6033919857947!2d108.21826422380751!3d16.08342073045062!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x314219003e42d0cd%3A0x29b3f014673024fd!2sMohana%20Coffee!5e0!3m2!1svi!2s!4v1754658965438!5m2!1svi!2s"
                            allowfullscreen="" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
}
